# Photon (iMessage)
SPECTRUM_PROJECT_ID=your-project-id
SPECTRUM_PROJECT_SECRET=your-project-secret
USER_PHONE=+15555550100

# Nemotron (OpenAI-compatible, build.nvidia.com)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
LLM_API_KEY=nvapi-...

# SpacetimeDB (local)
STDB_URI=ws://127.0.0.1:3000
STDB_DATABASE=focusguard

# Set to 1 to log iMessages to the terminal instead of sending them
FOCUSGUARD_DRY_RUN_SMS=0
